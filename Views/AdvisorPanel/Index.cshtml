@{
    ViewData["Title"] = "Asesor — Inicio de Sesión";
    ViewData["FullScreen"] = true;
}

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;z-index:1;padding:20px;">

    <div style="width:100%;max-width:440px;">

        <!-- Logo -->
        <div style="text-align:center;margin-bottom:40px;">
            <div class="bank-icon" style="margin:0 auto 16px;">🏦</div>
            <h1 style="font-size:1.8rem;"><span class="gradient-text">Panel del Asesor</span></h1>
            <p class="text-secondary-custom" style="font-size:0.9rem;margin-top:6px;">
                Accede con tus credenciales para gestionar los turnos
            </p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid #e74c3c;margin-bottom:16px;">
                <p style="color:#e74c3c;font-size:0.9rem;">@TempData["Error"]</p>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid var(--green);margin-bottom:16px;">
                <p style="color:var(--green);font-size:0.9rem;">@TempData["Success"]</p>
            </div>
        }

        <!-- Login Card -->
        <div class="glass-card" style="padding:36px;">

            <form asp-controller="Advisors" asp-action="Login" method="post" class="form-section">
                <div class="field-group">
                    <label class="field-label" for="adv-email">Correo electrónico</label>
                    <input id="adv-email" name="Email" class="field-input" type="email"
                           placeholder="asesor@bankturns.co" autocomplete="email" required />
                </div>
                <div class="field-group">
                    <label class="field-label" for="adv-pass">Contraseña</label>
                    <input id="adv-pass" name="Password" class="field-input" type="password"
                           placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn-gold btn-full">
                    Ingresar al Panel
                </button>
            </form>

            <div class="divider"></div>

            <!-- Registrar nuevo asesor -->
            <details style="cursor:pointer;">
                <summary style="font-size:0.82rem;color:var(--text-muted);list-style:none;display:flex;align-items:center;gap:6px;">
                    <span>⚙️</span> Registrar nuevo asesor
                </summary>
                <form asp-controller="Advisors" asp-action="Create" method="post" class="form-section" style="margin-top:16px;">
                    <div class="field-group">
                        <label class="field-label" for="new-name">Nombre</label>
                        <input id="new-name" name="Name" class="field-input" type="text"
                               placeholder="Nombre del asesor" />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="new-email">Correo</label>
                        <input id="new-email" name="Email" class="field-input" type="email"
                               placeholder="correo@bankturns.co" />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="new-pass">Contraseña</label>
                        <input id="new-pass" name="Password" class="field-input" type="password"
                               placeholder="Mínimo 6 caracteres" />
                    </div>
                    <button type="submit" class="btn-ghost btn-full">Crear Asesor</button>
                </form>
            </details>
        </div>

        <p class="text-muted-custom" style="text-align:center;font-size:0.8rem;margin-top:20px;">
            <a href="/Kiosk" style="color:var(--text-muted);text-decoration:none;">← Volver al Kiosco</a>
            &nbsp;·&nbsp;
            <a href="/WaitingRoom" style="color:var(--text-muted);text-decoration:none;">📺 Sala de Espera</a>
        </p>
    </div>
</div>
