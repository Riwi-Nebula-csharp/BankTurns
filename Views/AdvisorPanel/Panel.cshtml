@using BankTurns.Models
@{
    ViewData["Title"] = "Panel del Asesor";
    ViewData["FullScreen"] = true;

    var advisorId   = ViewBag.AdvisorId   as int?;
    var advisorName = ViewBag.AdvisorName as string ?? "Asesor";
    var queue       = ViewBag.Queue       as List<Turn> ?? new();
    var advisorTurns = ViewBag.AdvisorTurns as List<Turn> ?? new();
    var activeTurn  = ViewBag.ActiveTurn  as Turn;

    var pending    = queue.Where(t => t.Status == TurnStatus.Pending).OrderBy(t => t.CreatedAt).ToList();
    var inProgress = queue.Where(t => t.Status == TurnStatus.InProgress).ToList();
    var finished   = advisorTurns.Where(t => t.Status == TurnStatus.Finished).OrderByDescending(t => t.FinishedAt).ToList();
}

<div class="advisor-layout" style="position:relative;z-index:1;">

    <!-- ── Sidebar ──────────────────────────────────── -->
    <aside class="advisor-sidebar">
        <div class="advisor-logo">
            <div class="bank-icon" style="width:40px;height:40px;font-size:1.1rem;">🏦</div>
            <div>
                <div style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1rem;color:var(--text-primary);">BankTurns</div>
                <div style="font-size:0.72rem;color:var(--text-muted);">Panel de Atención</div>
            </div>
        </div>

        <div style="padding:16px;background:var(--red-light);border-radius:var(--radius-md);border:1px solid var(--glass-border);">
            <p style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:4px;">Asesor activo</p>
            <p style="font-weight:700;font-size:0.95rem;">@advisorName</p>
        </div>

        <div class="divider"></div>

        <nav style="display:flex;flex-direction:column;gap:4px;">
            <button class="nav-link-custom active" onclick="showSection('section-queue')">
                <span>📋</span> Cola de Espera
            </button>
            <button class="nav-link-custom" onclick="showSection('section-attended')">
                <span>✅</span> Turnos Atendidos
            </button>
        </nav>

        <div style="margin-top:auto;">
            <div class="divider"></div>
            <div style="display:flex;flex-direction:column;gap:10px;">
                <a href="/WaitingRoom" class="btn-ghost" style="text-decoration:none;font-size:0.85rem;justify-content:center;">
                    📺 Sala de Espera
                </a>
                <form asp-controller="Advisors" asp-action="Logout" method="post">
                    <button type="submit" class="btn-ghost" style="font-size:0.85rem;width:100%;">
                        🚪 Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- ── Main Panel ──────────────────────────────── -->
    <main class="advisor-main">

        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;">
            <div>
                <h1 style="font-size:1.6rem;"><span class="gradient-text">Panel de Atención</span></h1>
                <p class="text-secondary-custom" style="font-size:0.9rem;margin-top:4px;">Gestiona los turnos de tus clientes</p>
            </div>
            <div class="clock" id="panel-clock">00:00:00</div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid var(--green);margin-bottom:16px;">
                <p style="color:var(--green);font-size:0.9rem;">@TempData["Success"]</p>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid #e74c3c;margin-bottom:16px;">
                <p style="color:#e74c3c;font-size:0.9rem;">@TempData["Error"]</p>
            </div>
        }

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card glass-card">
                <div class="stat-value" style="color:var(--blue-accent);">@pending.Count</div>
                <div class="stat-label">En Cola</div>
            </div>
            <div class="stat-card glass-card">
                <div class="stat-value" style="color:var(--red-primary);">@inProgress.Count</div>
                <div class="stat-label">En Atención</div>
            </div>
            <div class="stat-card glass-card">
                <div class="stat-value" style="color:var(--green);">@finished.Count</div>
                <div class="stat-label">Finalizados Hoy</div>
            </div>
        </div>

        <!-- Action bar: turno activo del asesor -->
        <div class="glass-card" style="padding:20px 24px;margin-bottom:24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
            <div style="flex:1;min-width:200px;">
                <p style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);margin-bottom:4px;">
                    Turno actualmente en atención
                </p>
                <div style="display:flex;align-items:center;gap:12px;">
                    <span class="turn-number-sm">@(activeTurn?.Ticket ?? "—")</span>
                    <div>
                        <p style="font-weight:600;">@activeTurn?.User?.Name</p>
                        <p style="font-size:0.82rem;color:var(--text-secondary);">@activeTurn?.Reason</p>
                    </div>
                </div>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <form asp-controller="AdvisorPanel" asp-action="CallNext" method="post" style="display:inline;">
                    <button type="submit" class="btn-blue">
                        📣 Llamar Siguiente
                    </button>
                </form>
                @if (activeTurn != null)
                {
                    <button type="button" class="btn-green" onclick="document.getElementById('finish-modal').style.display='flex'">
                        ✓ Finalizar Turno
                    </button>
                }
                else
                {
                    <button type="button" class="btn-green" disabled style="opacity:0.4;cursor:not-allowed;">
                        ✓ Finalizar Turno
                    </button>
                }
            </div>
        </div>

        <!-- ── Sección: Cola ── -->
        <div id="section-queue">
            <h2 style="font-size:1.1rem;font-weight:600;margin-bottom:16px;">Cola de Espera</h2>
            <div class="turns-table-wrap">
                <table class="turns-table">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Cliente</th>
                            <th>Motivo</th>
                            <th>Hora</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var allActive = inProgress.Concat(pending).ToList();
                        }
                        @if (!allActive.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted);">
                                    Sin turnos en cola
                                </td>
                            </tr>
                        }
                        @foreach (var turn in allActive)
                        {
                            var isMine = turn.Status == TurnStatus.InProgress && turn.AdvisorId == advisorId;
                            <tr>
                                <td><strong style="color:var(--red-primary);">@turn.Ticket</strong></td>
                                <td>@turn.User?.Name</td>
                                <td style="color:var(--text-secondary);font-size:0.85rem;">@turn.Reason</td>
                                <td style="color:var(--text-muted);font-size:0.82rem;">
                                    @turn.CreatedAt.ToString("hh:mm tt")
                                </td>
                                <td>
                                    @if (turn.Status == TurnStatus.Pending)
                                    {
                                        <span class="badge badge-pending">En Cola</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-progress">En Atención@(isMine ? " ★" : "")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Sección: Atendidos ── -->
        <div id="section-attended" style="display:none;">
            <h2 style="font-size:1.1rem;font-weight:600;margin-bottom:16px;">Turnos Atendidos</h2>
            <div class="turns-table-wrap">
                <table class="turns-table">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Cliente</th>
                            <th>Motivo</th>
                            <th>Finalizado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!finished.Any())
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:32px;color:var(--text-muted);">
                                    Sin turnos atendidos aún
                                </td>
                            </tr>
                        }
                        @foreach (var turn in finished)
                        {
                            <tr>
                                <td><strong style="color:var(--green);">@turn.Ticket</strong></td>
                                <td>@turn.User?.Name</td>
                                <td style="color:var(--text-secondary);font-size:0.85rem;">@turn.Reason</td>
                                <td style="color:var(--text-muted);font-size:0.82rem;">
                                    ✅ @turn.FinishedAt?.ToString("hh:mm tt")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<!-- ── Modal: Finalizar Turno ── -->
<div class="modal-overlay" id="finish-modal" style="display:none;">
    <div class="modal-box">
        <div class="glass-card" style="padding:32px;">
            <h2 style="font-size:1.2rem;margin-bottom:6px;">Finalizar Turno</h2>
            <p class="text-secondary-custom" style="font-size:0.88rem;margin-bottom:20px;">
                Añade un comentario sobre la atención antes de cerrar el turno.
            </p>
            <form asp-controller="AdvisorPanel" asp-action="FinishTurn" method="post" class="form-section">
                <div class="field-group">
                    <label class="field-label" for="finish-comment">Comentario (opcional)</label>
                    <textarea id="finish-comment" name="comment" class="field-input"
                              placeholder="Ej: Se realizó apertura de cuenta, cliente satisfecho..."></textarea>
                </div>
                <div style="display:flex;gap:10px;">
                    <button type="submit" class="btn-green" style="flex:1;">
                        ✓ Confirmar y Cerrar
                    </button>
                    <button type="button" class="btn-ghost" style="flex:1;"
                            onclick="document.getElementById('finish-modal').style.display='none'">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Clock
    function tick() {
        document.getElementById('panel-clock').textContent =
            new Date().toLocaleTimeString('es-CO');
    }
    tick(); setInterval(tick, 1000);

    // Section navigation
    window.showSection = function(id) {
        ['section-queue', 'section-attended'].forEach(function(s) {
            document.getElementById(s).style.display = s === id ? '' : 'none';
        });
        document.querySelectorAll('.nav-link-custom').forEach(function(btn) {
            btn.classList.toggle('active', (btn.getAttribute('onclick') || '').includes(id));
        });
    };
</script>
}
