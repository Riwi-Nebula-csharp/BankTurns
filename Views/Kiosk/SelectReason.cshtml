@{
    ViewData["Title"] = "Motivo de Visita";
    ViewData["FullScreen"] = true;
}

<div class="kiosk-page kiosk-accessible-page">
    <div class="kiosk-container kiosk-accessible-container">

        <div class="kiosk-logo">
            <div class="bank-icon">🏦</div>
            <h1 class="kiosk-accessible-title">
                <span class="gradient-text">BankTurns</span>
            </h1>
            <p class="text-secondary-custom kiosk-accessible-subtitle">Bienvenido, @ViewBag.UserName</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid #e74c3c;margin-bottom:16px;">
                <p style="color:#e74c3c;font-size:0.9rem;">@TempData["Error"]</p>
            </div>
        }

        <div class="glass-card kiosk-accessible-card">
            <h2 class="kiosk-accessible-heading">Motivo de Visita</h2>
            <p class="text-secondary-custom kiosk-accessible-help">
                ¿En qué podemos ayudarte hoy?
            </p>

            <form asp-controller="Kiosk" asp-action="CreateTurn" method="post" class="form-section">
                <input type="hidden" name="UserId" value="@ViewBag.UserId" />
                <div class="field-group">
                    <label class="field-label" for="reason">Motivo de visita</label>
                    <div class="bank-options" role="radiogroup" aria-labelledby="reason">
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="Deposit" required />
                            <span>Depósito</span>
                        </label>
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="Withdraw" />
                            <span>Retiro</span>
                        </label>
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="AccountManagement" />
                            <span>Gestión de cuenta</span>
                        </label>
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="Documents" />
                            <span>Documentos</span>
                        </label>
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="Loan" />
                            <span>Préstamo</span>
                        </label>
                        <label class="bank-option">
                            <input type="radio" name="Reason" value="Complaints" />
                            <span>Quejas</span>
                        </label>
                    </div>
                </div>
                <button type="submit" class="btn-gold btn-full">
                    Solicitar Turno 🎫
                </button>
            </form>
            <style>
                .bank-options {
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 16px;
                    margin-top: 16px;
                }
                .bank-option {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    min-height: 88px;
                    padding: 22px;
                    border: 2px solid var(--glass-border);
                    border-radius: var(--radius-md);
                    background: #fff;
                    cursor: pointer;
                    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
                    color: var(--text-primary);
                }
                .bank-option input {
                    width: 1.6rem;
                    height: 1.6rem;
                    flex: 0 0 auto;
                }
                .bank-option span {
                    color: var(--text-primary);
                    font-weight: 800;
                    font-size: 1.3rem;
                    line-height: 1.2;
                }
                .bank-option:hover,
                .bank-option input:focus-visible + span,
                .bank-option:has(input:checked) {
                    border-color: var(--red-primary);
                    transform: translateY(-1px);
                    background: var(--red-light);
                }
                .bank-option input:checked + span {
                    color: var(--red-primary);
                }
                @@media (max-width: 640px) {
                    .bank-options {
                        grid-template-columns: 1fr;
                    }
                }
            </style>
        </div>

    </div>
</div>
