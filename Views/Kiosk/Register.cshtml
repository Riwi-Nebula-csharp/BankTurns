@{
    ViewData["Title"] = "Registro de Usuario";
    ViewData["FullScreen"] = true;
}

<div class="kiosk-page">
    <div class="kiosk-container">

        <div class="kiosk-logo">
            <div class="bank-icon">🏦</div>
            <h1 style="font-size:2rem;margin-bottom:6px;">
                <span class="gradient-text">BankTurns</span>
            </h1>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="glass-card" style="padding:12px 20px;border-left:3px solid #e74c3c;margin-bottom:16px;">
                <p style="color:#e74c3c;font-size:0.9rem;">@TempData["Error"]</p>
            </div>
        }

        <div class="glass-card" style="padding:32px;">
            <a href="/Kiosk" class="btn-ghost" style="margin-bottom:16px;padding:6px 12px;font-size:0.8rem;display:inline-block;">
                ← Volver
            </a>
            <h2 style="font-size:1.3rem;margin-bottom:6px;">Registro de Usuario</h2>
            <p class="text-secondary-custom" style="font-size:0.9rem;margin-bottom:24px;">
                No encontramos tu documento. Completa tus datos para continuar.
            </p>

            <form asp-controller="Kiosk" asp-action="Register" method="post" class="form-section">
                <div class="field-group">
                    <label class="field-label">Documento</label>
                    <input name="document" class="field-input" type="text"
                           value="@ViewBag.Document" readonly style="opacity:0.6;" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="name">Nombre completo</label>
                    <input id="name" name="name" class="field-input" type="text"
                           placeholder="Tu nombre" required />
                </div>
                <button type="submit" class="btn-gold btn-full">
                    Continuar →
                </button>
            </form>
        </div>

    </div>
</div>
