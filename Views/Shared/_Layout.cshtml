<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sistema de Gestión de Turnos Bancarios — BankTurns" />
    <title>@ViewData["Title"] — BankTurns</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/bank-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-mesh"></div>
    <div class="toast-container" id="toast-container"></div>

    @if (ViewData["FullScreen"] is not true)
    {
        <!-- Mini-nav only for non-fullscreen pages -->
        <nav class="top-navbar">
            <a asp-controller="Home" asp-action="Index" class="top-navbar-brand">
                <div class="bank-icon" style="width:36px;height:36px;font-size:1.1rem;">🏦</div>
                <span class="top-navbar-brand-text">BankTurns</span>
            </a>
            <div class="top-navbar-actions">
                <a asp-controller="Kiosk" asp-action="Index" class="btn-ghost" style="padding:8px 16px;font-size:0.85rem;text-decoration:none;">🎫 Turno</a>
                <a asp-controller="WaitingRoom" asp-action="Index" class="btn-ghost" style="padding:8px 16px;font-size:0.85rem;text-decoration:none;">📺 Sala</a>
                <a asp-controller="AdvisorPanel" asp-action="Index" class="btn-gold" style="padding:8px 18px;font-size:0.85rem;text-decoration:none;">👤 Asesor</a>
            </div>
        </nav>
        <div style="padding-top:70px;min-height:100vh;position:relative;z-index:1;">
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Global toast utility
        function showToast(msg, type = 'info') {
            const c = document.getElementById('toast-container');
            const t = document.createElement('div');
            t.className = `toast toast-${type}`;
            t.textContent = msg;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity 0.4s'; setTimeout(()=>t.remove(),400); }, 3500);
        }
    </script>
</body>
</html>

