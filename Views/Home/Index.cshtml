@{
    ViewData["Title"] = "Inicio";
}

<div style="max-width:900px;margin:60px auto;padding:20px;position:relative;z-index:1;">
    <div style="text-align:center;margin-bottom:60px;">
        <div class="bank-icon" style="width:80px;height:80px;font-size:2.2rem;margin:0 auto 20px;box-shadow:var(--shadow-gold);">🏦</div>
        <h1 style="font-size:3rem;margin-bottom:12px;"><span class="gradient-text">BankTurns</span></h1>
        <p style="font-size:1.15rem;color:var(--text-secondary);max-width:500px;margin:0 auto;">
            Sistema de Gestión de Turnos Bancarios — eficiente, ordenado y en tiempo real.
        </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">

        <a href="/Kiosk" style="text-decoration:none;">
            <div class="glass-card" style="padding:28px;text-align:center;cursor:pointer;transition:all 0.25s;">
                <div style="font-size:2.5rem;margin-bottom:12px;">🎫</div>
                <h2 style="font-size:1.1rem;margin-bottom:8px;">Panel de Turno</h2>
                <p style="font-size:0.85rem;color:var(--text-secondary);">Registra tu visita y obtén tu ticket de atención.</p>
                <div style="margin-top:16px;">
                    <span class="badge badge-pending">Kiosco</span>
                </div>
            </div>
        </a>

        <a href="/WaitingRoom" style="text-decoration:none;">
            <div class="glass-card" style="padding:28px;text-align:center;cursor:pointer;transition:all 0.25s;">
                <div style="font-size:2.5rem;margin-bottom:12px;">📺</div>
                <h2 style="font-size:1.1rem;margin-bottom:8px;">Sala de Espera</h2>
                <p style="font-size:0.85rem;color:var(--text-secondary);">Pantalla pública con turnos en cola y el turno actual.</p>
                <div style="margin-top:16px;">
                    <span class="badge badge-progress">En Vivo</span>
                </div>
            </div>
        </a>

        <a href="/AdvisorPanel" style="text-decoration:none;">
            <div class="glass-card" style="padding:28px;text-align:center;cursor:pointer;transition:all 0.25s;">
                <div style="font-size:2.5rem;margin-bottom:12px;">👤</div>
                <h2 style="font-size:1.1rem;margin-bottom:8px;">Panel del Asesor</h2>
                <p style="font-size:0.85rem;color:var(--text-secondary);">Gestiona la atención: llama, finaliza y comenta turnos.</p>
                <div style="margin-top:16px;">
                    <span class="badge badge-finished">Gestión</span>
                </div>
            </div>
        </a>
    </div>

    <div class="divider" style="margin:48px 0;"></div>

    <div style="text-align:center;">
        <p style="font-size:0.8rem;color:var(--text-muted);">
            Sistema desarrollado por el equipo Riwi · Nebula C# &nbsp;·&nbsp; Flujo: Pendiente → En Espera → En Atención → Finalizado
        </p>
    </div>
</div>
